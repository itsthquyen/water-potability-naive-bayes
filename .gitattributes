* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ipynb text eol=lf
*.pdf binary
*.docx binary

# Giữ nguyên bytes dữ liệu và kết quả để SHA-256 không đổi khi clone Windows.
/data/raw/*.csv -text
/data/splits/*.txt -text
/data/*.json -text
/artifacts/** -text whitespace=cr-at-eol
/results/** -text whitespace=cr-at-eol
# Native Weka logs contain aligned trailing spaces; preserve their exact bytes.
/results/comparison/**/weka/*_weka.txt -text -whitespace
